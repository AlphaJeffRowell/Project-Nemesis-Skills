# Environment Configuration — Local Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# To activate for the current PowerShell session:
#   . .\scripts\load-env.ps1
#
# To activate and persist across all future sessions (writes to User env):
#   . .\scripts\load-env.ps1 -Persist
# ─────────────────────────────────────────────────────────────────────────────

# Azure DevOps
# Organization URL — e.g. https://dev.azure.com/YourOrg/YourProject
ADO_ORG_URL=your-ado-org-url-here
# Personal Access Token
# Generate at: <ADO_ORG_URL>/_userSettings/tokens
# Required scopes: Code (Read), Pull Request Threads (Read)
ADO_PAT=your-azure-devops-pat-here
# Repository GUID
# Find it by opening: <ADO_ORG_URL>/_apis/git/repositories?api-version=7.1
# Copy the repository "id" field
ADO_REPO_ID=your-ado-repo-guid-here

# Asana Project Management
# Project Name or ID (for task tracking and integration)
ASANA_PROJECT_NAME=your-asana-project-name
ASANA_PROJECT_ID=your-asana-project-id

# SharePoint
# Client folder URLs for document management
SHAREPOINT_CLIENT_FOLDER_URL=https://your-organization.sharepoint.com/sites/Clients/your-client-code
SHAREPOINT_DOCUMENTS_URL=https://your-organization.sharepoint.com/sites/Clients/your-client-code/Documents

# Anthropic (Claude AI Workbench — local scripts only)
# Generate at: https://console.anthropic.com/settings/keys
# Required for: scripts/workbench.py, scripts/claude_client.py
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (Copilot-grade AI — Email Capture Add-in)
# Generate at: https://platform.openai.com/api-keys
# Required for: Email Capture Outlook add-in (gpt-4o-mini extraction)
OPENAI_API_KEY=your-openai-api-key-here

# GitHub
# Handled by the gh CLI for most operations — run: gh auth login
# GITHUB_PAT is used by the Email Note Capture Power Automate flow to write
# markdown files directly to the repository via the GitHub REST API.
# Generate at: GitHub → Settings → Developer Settings → Personal Access Tokens
# → Tokens (classic) → Generate new token → check 'repo' scope
GITHUB_PAT=your-github-pat-here

# Everest Web API (Data Source execution)
# Values sourced from client documentation (Okta client-credentials flow)
EVEREST_UAT_BASE_URL=https://your-uat-instance.allvuecloud.com
EVEREST_UAT_TOKEN_URL=https://identity.allvuecloud.com/oauth2/your-auth-domain/v1/token
EVEREST_UAT_CLIENT_ID=your-uat-client-id-here
EVEREST_UAT_CLIENT_SECRET=your-uat-client-secret-here

EVEREST_PROD_BASE_URL=https://your-prod-instance.allvuecloud.com
EVEREST_PROD_TOKEN_URL=https://identity.allvuecloud.com/oauth2/your-auth-domain/v1/token
EVEREST_PROD_CLIENT_ID=your-prod-client-id-here
EVEREST_PROD_CLIENT_SECRET=your-prod-client-secret-here

EVEREST_SCOPE=ClientCredential
